{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": ["manifest.ts", "vite.config.ts", "scripts", "background", "popup", "pages", "shared", "content"]
}
